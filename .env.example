# Copie ce fichier en .env et remplis les valeurs. Ne jamais commit .env.
# Les clés des services (France Travail, Adzuna, Jooble, email, trajets) se remplissent plus simplement
# dans le site : menu « Réglages » (le site écrit ce fichier pour toi et garde une copie .env.bak).

# --- Base de données (intégrée, sans Docker : fichiers dans le dossier data\) ---
# Utilisateur, mot de passe, port et nom de la base. L'installeur génère un mot de passe aléatoire.
DATABASE_URL=postgresql://jobradar:change-moi@127.0.0.1:5433/jobradar

# --- France Travail (francetravail.io) ---
FRANCE_TRAVAIL_CLIENT_ID=
FRANCE_TRAVAIL_CLIENT_SECRET=

# --- Adzuna (étape 11) ---
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# --- Jooble (fr.jooble.org/api/about) — clé gratuite, 500 appels au total ---
JOOBLE_API_KEY=

# --- IA locale gratuite (Ollama, https://ollama.com) — facultatif, valeurs par défaut ci-dessous ---
# OLLAMA_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=gemma4:e4b
# Modèle plus gros pour la lettre de motivation seulement (plus lent, mieux écrit ; à télécharger : ollama pull gemma4:12b)
# OLLAMA_LETTER_MODEL=gemma4:12b

# --- Email (étape 10) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Gmail : SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=ton adresse,
# SMTP_PASSWORD=mot de passe d'application (myaccount.google.com/apppasswords)
SMTP_FROM=
NOTIFY_EMAIL_TO=

# --- Compte (facultatif) ---
# Laisse vide : ton compte se crée sur le site au premier lancement, avec ton CV.
SEED_USER_EMAIL=
SEED_USER_PASSWORD=

# --- Application ---
APP_URL=http://localhost:5173
SESSION_SECRET=

CRON_INTERVAL_MINUTES=30
# false = pas de collecte automatique (bouton Actualiser seulement)
SCHEDULER_ENABLED=true
MIN_JOB_SCORE_FOR_NOTIFICATION=70

# --- Notifications navigateur (générées par pnpm setup:push) ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# --- Transports en commun en Île-de-France (compte gratuit sur prim.iledefrance-mobilites.fr) ---
# Facultatif : sans clé, le trajet est calculé en voiture partout en France (IGN, sans clé).
PRIM_API_KEY=

# --- ESSAI JobScraper (LinkedIn, HelloWork, Welcome to the Jungle) — facultatif, voir docs/JOBSCRAPER.md ---
JOBSCRAPER_ENABLED=false
JOBSCRAPER_PATH=tools/jobscraper
# JOBSCRAPER_PYTHON=C:/chemin/vers/python.exe
JOBSCRAPER_TIMEOUT_MS=120000
