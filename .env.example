# Copie ce fichier en .env et remplis les valeurs. Ne jamais commit .env.

# --- Base de données (Docker) ---
POSTGRES_USER=jobradar
POSTGRES_PASSWORD=change-moi
POSTGRES_DB=jobradar
POSTGRES_PORT=5432
DATABASE_URL=postgresql://jobradar:change-moi@localhost:5432/jobradar

# --- Redis (file d'attente) ---
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# --- France Travail (francetravail.io) ---
FRANCE_TRAVAIL_CLIENT_ID=
FRANCE_TRAVAIL_CLIENT_SECRET=

# --- Adzuna (étape 11) ---
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# --- IA locale gratuite (Ollama, https://ollama.com) — facultatif, valeurs par défaut ci-dessous ---
# OLLAMA_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=gemma4:e4b

# --- Email (étape 10) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Gmail : SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=ton adresse,
# SMTP_PASSWORD=mot de passe d'application (myaccount.google.com/apppasswords)
SMTP_FROM=
NOTIFY_EMAIL_TO=

# --- Ton compte pour te connecter à l'appli ---
SEED_USER_EMAIL=
SEED_USER_PASSWORD=

# --- Application ---
APP_URL=http://localhost:5173
SESSION_SECRET=

CRON_INTERVAL_MINUTES=5
# false = pas de collecte automatique (bouton Actualiser seulement)
SCHEDULER_ENABLED=true
MIN_JOB_SCORE_FOR_NOTIFICATION=70

# --- Notifications navigateur (générées par pnpm setup:push) ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# --- Temps de trajet (compte gratuit sur prim.iledefrance-mobilites.fr) ---
PRIM_API_KEY=
